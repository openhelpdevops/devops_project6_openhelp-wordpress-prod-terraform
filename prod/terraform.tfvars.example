aws_region   = "us-east-1"
project_name = "openhelp"
environment  = "prod"

vpc_cidr              = "10.20.0.0/16"
availability_zones     = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs    = ["10.20.1.0/24", "10.20.2.0/24"]
app_subnet_cidrs       = ["10.20.11.0/24", "10.20.12.0/24"]
db_subnet_cidrs        = ["10.20.21.0/24", "10.20.22.0/24"]

instance_type = "t3.micro"

domain_name         = "openhelp.net"
route53_zone_name   = "openhelp.net"
create_route53_zone = true
enable_https        = false

db_name                  = "wordpress"
db_username              = "wpadmin"
db_instance_class        = "db.t3.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_backup_retention_days = 1
db_multi_az             = false

waf_rate_limit         = 2000
waf_blocked_ipv4_cidrs = []

# Bastion access. Leave empty to automatically allow only the current public
# IPv4 address of the machine running Terraform. For a fixed corporate/admin
# CIDR, set for example: ["198.51.100.25/32"]
bastion_instance_type      = "t3.micro"
bastion_allowed_ssh_cidrs = []
ssh_private_key_filename   = "openhelp-prod-bastion.pem"
